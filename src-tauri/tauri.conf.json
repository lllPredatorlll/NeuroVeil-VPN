{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "NeuroVeil VPN 2.0",
  "version": "2.0.6",
  "identifier": "com.neuroveil.vpn2",
  "build": {
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "NeuroVeil VPN 2.0",
        "width": 460,
        "height": 680,
        "resizable": true,
        "maximizable": false,
        "fullscreen": false,
        "visible": false,
        "center": true,
        "decorations": false,
        "shadow": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/icon.png",
      "icons/icon.ico"
    ]
  }
}
